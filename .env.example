# Application Environment
ENVIRONMENT=development
DEBUG=false

# Backend Port and CORS Configuration
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend API Base URL (browser reachable)
VITE_API_BASE_URL=http://localhost:8000

# Elexon Insights Solution API Base URL
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Sample Day-Ahead Decision Cutoff Time (UTC)
# Note: 09:50 UTC is a configurable N2EX sample, not a universal UK cutoff
DEFAULT_DECISION_CUTOFF_TIME=09:50

# January 2026 Evaluation Horizon
DECISION_START_DATE=2026-01-01
DECISION_END_DATE=2026-01-31
DELIVERY_START_DATE=2026-01-02
DELIVERY_END_DATE=2026-02-01
